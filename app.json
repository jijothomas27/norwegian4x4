{
  "expo": {
    "name": "Tempo",
    "slug": "norwegian4x4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jijothomas.tempo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.jijothomas.tempo",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "norwegian4x4",
    "backgroundColor": "#121214",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Tempo connects to your watch or chest strap to show live heart rate during workouts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aeb5684a-5fba-450b-a7b9-fb0ee86b5149"
      }
    }
  }
}
